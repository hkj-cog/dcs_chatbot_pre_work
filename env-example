# ── GCP Core ──────────────────────────────────────────────────────────────────
# GCP project ID used for all cloud service API calls.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GCP region for Vertex AI, DLP, and other location-sensitive services.
GOOGLE_CLOUD_LOCATION=australia-southeast1

# Routes GenAI SDK requests through Vertex AI instead of Google AI Studio; not a Settings field.
GOOGLE_GENAI_USE_VERTEXAI=1

# ── Agent / Model ─────────────────────────────────────────────────────────────
# Gemini model ID used for the main chat agent and all LLM judge calls.
MODEL_ID=gemini-2.5-flash

# Full Vertex AI Search datastore path; leave empty for guardrail-only testing (not suitable for production).
DATASTORE_ID=projects/your-gcp-project-id/locations/global/collections/default_collection/dataStores/your-datastore-id

# ── PII / DLP ─────────────────────────────────────────────────────────────────
# JSON list of Cloud DLP info-type names to detect and redact; AUSTRALIA_ABN_NUMBER is handled locally via regex.
PII_DATA_TYPES=["EMAIL_ADDRESS","PHONE_NUMBER","FIRST_NAME","LAST_NAME","PASSPORT","AUSTRALIA_TAX_FILE_NUMBER","AUSTRALIA_MEDICARE_NUMBER","AUSTRALIA_DRIVERS_LICENSE_NUMBER","DATE_OF_BIRTH"]

# ── Ban Words ─────────────────────────────────────────────────────────────────
# Hard-block words; any match immediately blocks the message.
BANNED_WORDS=[]
# Soft-block words; blocked unless a context allowlist pattern matches.
BANNED_WORDS_SOFT=[]
# Warn-only words; logged but allowed through.
BANNED_WORDS_WARN=[]
# Regex patterns that downgrade a soft/warn match when context suggests legitimate use (e.g. legal citations).
BAN_WORD_CONTEXT_ALLOWLIST=[]
# Per-language JSON map of hard-block words, keyed by BCP-47 language code.
BANNED_WORDS_BY_LANGUAGE={}
# Per-language JSON map of soft-block words.
BANNED_WORDS_SOFT_BY_LANGUAGE={}
# Per-language JSON map of warn-only words.
BANNED_WORDS_WARN_BY_LANGUAGE={}
# Rapidfuzz token score (0–100) at or above which a word is considered a ban-word match.
BAN_WORD_FUZZY_THRESHOLD=85

# ── Tool Call Guard ───────────────────────────────────────────────────────────
# Fuzzy-matched terms blocked from being sent as queries to the Vertex AI Search datastore.
BLOCKED_QUERY_TERMS=["financial records", "personal employee data"]

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Maximum requests per session per minute before rate-limiting kicks in.
RATE_LIMIT_PER_MINUTE=60

# ── Session Threat Tracking ───────────────────────────────────────────────────
# Number of security blocks within the window before the session is escalated to SIEM.
SESSION_THREAT_THRESHOLD=5
# Sliding window duration (seconds) used to count security block events per session.
SESSION_THREAT_WINDOW_SECONDS=3600

# ── Input / Output Limits ─────────────────────────────────────────────────────
# Maximum character length accepted for user input; longer messages are blocked.
MAX_INPUT_CHARS=4000
# Maximum character length for LLM output; longer responses are blocked before delivery.
MAX_OUTPUT_CHARS=8000
# Hard timeout (seconds) for the entire pipeline; a timeout error message is delivered to the user if exceeded.
PIPELINE_TIMEOUT_SECONDS=18

# ── Language Detection ────────────────────────────────────────────────────────
# Minimum detection confidence to act on a detected language; below this, language rules are skipped.
LANGUAGE_DETECTION_CONFIDENCE_THRESHOLD=0.80
# BCP-47 codes the LLM may respond in; output in any other language is blocked.
SUPPORTED_OUTPUT_LANGUAGES=["en"]
# User input languages that trigger auto-translation back to the user's detected language.
SUPPORTED_INPUT_LANGUAGES=["en"]

# ── Redis ─────────────────────────────────────────────────────────────────────
# Accepts plain host:port (redis:// prefix added automatically) or a full Redis URL.
REDIS_HOST=127.0.0.1:6379

# ── Pub/Sub ───────────────────────────────────────────────────────────────────
# Pub/Sub topic name used to deliver pipeline responses back to the responder service.
QUEUE_TOPIC=adk_chat_messages
# Local Pub/Sub emulator address; also signals local-dev mode (uses InMemorySessionService, optional datastore).
PUBSUB_EMULATOR_HOST=127.0.0.1:8406

# ── WebSocket ─────────────────────────────────────────────────────────────────
# Redis TTL (seconds) for status:{session_id} presence keys; must exceed the full pipeline round-trip time.
WS_SESSION_TTL_SECONDS=6000

# ── WebSocket inbox (lost-first-reply buffer) ─────────────────────────────────
# Set to false to disable inbox buffering; undeliverable replies return 503 so Pub/Sub retries.
WS_INBOX_ENABLED=true
# Max time (seconds) a buffered reply lives in Redis before being discarded.
WS_INBOX_TTL_SECONDS=120
# Per-session cap on buffered messages; oldest entries are trimmed when the cap is exceeded.
WS_INBOX_MAX_MESSAGES=20

# ── HTTP / CORS ───────────────────────────────────────────────────────────────
# Comma-separated allowed origins; wildcards are rejected because allow_credentials=true requires explicit origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000,http://localhost:3000,http://localhost:8000

# ── Observability (GCP Cloud Trace + Cloud Logging) ───────────────────────────
# Master switch; set to false to disable all OTel tracing and instrumentation.
OBSERVABILITY_ENABLED=true
# Service name applied to all OTel spans and log records.
OTEL_SERVICE_NAME=dcs_chatbot
# Exports spans to Cloud Trace and logs to Cloud Logging; set false for local dev without GCP credentials.
OBSERVABILITY_EXPORT_TO_GCP=true
# Fraction of traces sampled (1.0 = all, 0.1 = 10%).
OBSERVABILITY_SAMPLE_RATIO=1.0
# Redacts PII from span attributes and log messages before they leave the process.
OBSERVABILITY_REDACT_PII=true
# Log output format: 'json' for Cloud Logging correlation, 'text' for local dev readability.
LOG_FORMAT=json
# File path used by the eval pipeline to track the last processed Cloud Logging entry timestamp.
EVAL_CURSOR_FILE=cursor.json

# ── Guardrail Kill Switches ───────────────────────────────────────────────────
# JSON list of guardrail class names to disable; SecretsInputGuardRail, JailbreakGuardRail, and DlpOutputGuardRail cannot be disabled.
DISABLED_GUARDRAILS=[]
